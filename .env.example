# Copy to .env (production) and adjust
PORT=3001
HOST=127.0.0.1
# Set to 0 to close sign-ups once everyone who needs an account has one
ALLOW_REGISTRATION=1
# Set to 1 when served over HTTPS (marks the session cookie Secure)
COOKIE_SECURE=1
# Optional: where the SQLite file lives (default server/data/finance.db)
# DB_PATH=/var/lib/finance/finance.db
